<?xml version="1.0" encoding="UTF-8"?>
<!-- child.*.inherit.append.path="false": the modules inherit the url and scm as they are,
     instead of with "/<artifactId>" appended (such as https://github.com/amosshi/binaryinternals.git/binaryinternals.format.bmp) -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.binaryinternals</groupId>
    <artifactId>binaryinternals</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Binary Internals</name>
    <description>Show binary file internals visually and interactively for the meaning of every bit</description>
    <url>https://www.binaryinternals.org</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <organization>
        <name>Binary Internals</name>
        <url>https://www.binaryinternals.org</url>
    </organization>

    <developers>
        <developer>
            <id>ashi</id>
            <name>Amos Shi</name>
            <url>https://github.com/amosshi</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/amosshi/binaryinternals.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/amosshi/binaryinternals.git</developerConnection>
        <url>https://github.com/amosshi/binaryinternals</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/amosshi/binaryinternals/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/amosshi/binaryinternals/actions</url>
    </ciManagement>

    <properties>
        <revision>3.7</revision><!-- the project version: https://maven.apache.org/maven-ci-friendly.html -->

        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible builds: the time (UTC) of the last git commit, for the jar and zip entries and the Release-Date manifest entry.
             Set by git-commit-id-maven-plugin at initialize; without a .git folder, see the profile no-git -->
        <project.build.outputTimestamp>${git.commit.time}</project.build.outputTimestamp>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format><!-- for the profile no-git -->
        <maven.compiler.failOnWarning>true</maven.compiler.failOnWarning><!-- javac -Werror for the -Xlint:all warnings; override with -Dmaven.compiler.failOnWarning=false -->
        <!-- Read by the plugins directly, so no <configuration> is needed; override with -D...=false -->
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <spotbugs.failOnError>true</spotbugs.failOnError>
        <pmd.failOnViolation>true</pmd.failOnViolation>

        <!-- Read by the plugins both in the build and in the site reports, so both use the same rules -->
        <!-- OpenJDK Java Style, bundled with Checkstyle and used unchanged: https://github.com/checkstyle/checkstyle/blob/master/src/main/resources/openjdk_checks.xml -->
        <checkstyle.config.location>openjdk_checks.xml</checkstyle.config.location>
        <checkstyle.suppressions.location>${maven.multiModuleProjectDirectory}/checkstyle-suppressions.xml</checkstyle.suppressions.location>
        <spotbugs.excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude-filter.xml</spotbugs.excludeFilterFile>
        <spotbugs.xmlOutput>true</spotbugs.xmlOutput>
        <!-- The Java version PMD parses the sources as; the plugin's default, ${maven.compiler.source}, is not set here -->
        <targetJdk>${maven.compiler.release}</targetJdk>
        <!-- The plugin's default ruleset still lists rules deprecated in PMD 7.27.0 -->
        <pmd.ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</pmd.ruleset>

        <pmd.version>7.29.0</pmd.version><!-- https://mvnrepository.com/artifact/net.sourceforge.pmd/pmd-java -->
        <junit-jupiter.version>6.1.3</junit-jupiter.version><!-- https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter -->
        <spotbugs.version>4.10.5</spotbugs.version><!-- https://mvnrepository.com/artifact/com.github.spotbugs/spotbugs-annotations -->
        <umldoclet.version>2.3.2</umldoclet.version><!-- https://mvnrepository.com/artifact/nl.talsmasoftware/umldoclet -->
    </properties>

    <!-- Versions used by the modules, which declare their dependencies without a version -->
    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: keep each version in sync with the <version> in the module's own pom.xml -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.commonlib</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.bmp</artifactId>
                <version>1.1</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.class</artifactId>
                <version>25.0</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.dex</artifactId>
                <version>0.8</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.elf</artifactId>
                <version>0.3</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.jpeg</artifactId>
                <version>2.1</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.pdf</artifactId>
                <version>0.6</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.png</artifactId>
                <version>1.1</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>binaryinternals.format.zip</artifactId>
                <version>0.8</version>
            </dependency>

            <!-- JUnit: all its artifacts in the same version -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs.version}</version>
            <scope>provided</scope><!-- Compile time only, not packaged: "requires static" in module-info.java -->
        </dependency>
    </dependencies>

    <build>
        <!-- The version of every plugin, including the ones Maven adds by default (clean, resources, surefire, install).
             Plugins in <plugins> and <reporting>, here and in the modules, are declared without a version. -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.9.0</version><!-- https://mvnrepository.com/artifact/org.codehaus.mojo/flatten-maven-plugin -->
                </plugin>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>10.0.1</version><!-- https://mvnrepository.com/artifact/io.github.git-commit-id/git-commit-id-maven-plugin -->
                </plugin>
                <!-- Reproducible builds check: mvn initialize artifact:check-buildplan (initialize: for git.commit.time); after an install: mvn clean verify artifact:compare -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-artifact-plugin</artifactId>
                    <version>3.7.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-artifact-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.8.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-assembly-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-checkstyle-plugin -->
                    <!-- Declared here, not in <build><plugins>, so the site report uses the same Checkstyle version and settings -->
                    <configuration>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory><!-- no user property for it -->
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>14.4.0</version><!-- https://mvnrepository.com/artifact/com.puppycrawl.tools/checkstyle -->
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-clean-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-compiler-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-dependency-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-deploy-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.7.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-enforcer-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-install-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-jar-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-javadoc-plugin -->
                    <!-- Declared here, so the site report and the release profile's Javadoc jar use the same settings -->
                    <configuration>
                        <additionalJOption>-J-Xmx4g</additionalJOption>
                        <doclint>all,-missing</doclint><!-- every check except the missing Javadoc comments, for now -->
                        <header>Binary Internals &lt;br&gt; View Internals of Binary File</header>
                        <show>private</show>

                        <!-- Generate UML diagrams into the Javadoc -->
                        <doclet>nl.talsmasoftware.umldoclet.UMLDoclet</doclet>
                        <docletArtifact>
                            <groupId>nl.talsmasoftware</groupId>
                            <artifactId>umldoclet</artifactId>
                            <version>${umldoclet.version}</version>
                        </docletArtifact>
                        <useStandardDocletOptions>true</useStandardDocletOptions>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jdeps-plugin</artifactId>
                    <version>3.2.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-jdeps-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jxr-plugin</artifactId>
                    <version>3.6.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-jxr-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-pmd-plugin -->
                    <configuration>
                        <rulesets>
                            <ruleset>${pmd.ruleset}</ruleset>
                        </rulesets>
                    </configuration>
                    <!-- A newer PMD than the one bundled with the plugin, the same in the build and in the site report:
                         https://maven.apache.org/plugins/maven-pmd-plugin/examples/upgrading-PMD-at-runtime.html -->
                    <dependencies>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-javascript</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-jsp</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>3.9.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-project-info-reports-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-resources-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-site-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-source-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-surefire-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-report-plugin</artifactId>
                    <version>3.6.1</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-surefire-report-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-wrapper-plugin</artifactId>
                    <version>3.3.4</version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-wrapper-plugin -->
                </plugin>
                <!-- Dependency graph of the modules, shown in the README: mvn depgraph:aggregate (needs Graphviz "dot" on the PATH) -->
                <plugin>
                    <groupId>com.github.ferstl</groupId>
                    <artifactId>depgraph-maven-plugin</artifactId>
                    <version>4.0.6</version><!-- https://mvnrepository.com/artifact/com.github.ferstl/depgraph-maven-plugin -->
                    <configuration>
                        <createImage>true</createImage>
                        <imageFormat>svg</imageFormat>
                        <includes>
                            <include>org.binaryinternals</include>
                        </includes>
                        <excludes>
                            <exclude>org.binaryinternals:binaryinternals.apps</exclude><!-- the applications' parent pom, not a dependency -->
                        </excludes>
                        <showGroupIds>true</showGroupIds>
                        <showVersions>true</showVersions>
                        <outputDirectory>${maven.multiModuleProjectDirectory}/docs</outputDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.5.0</version><!-- https://mvnrepository.com/artifact/com.github.spotbugs/spotbugs-maven-plugin -->
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.24.0</version><!-- https://mvnrepository.com/artifact/org.codehaus.mojo/versions-maven-plugin -->
                    <configuration>
                        <!-- Report only stable releases: skip alpha, beta, RC, milestone, preview and snapshot versions -->
                        <ruleSet>
                            <ignoreVersions>
                                <ignoreVersion>
                                    <type>regex</type>
                                    <version>(?i).*-(alpha|beta|rc|cr|m|milestone|preview|snapshot)[.-]?\d*.*</version>
                                </ignoreVersion>
                            </ignoreVersions>
                        </ruleSet>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <!-- Fail fast on unsupported Maven or JDK -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion><!-- keep in sync with distributionUrl in .mvn/wrapper/maven-wrapper.properties -->
                                    <version>[3.10.0,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                </requireJavaVersion>
                                <!-- Every plugin used has its version pinned in <pluginManagement> -->
                                <requirePluginVersions/>
                                <!-- One version per dependency across the transitive tree -->
                                <dependencyConvergence/>
                                <!-- No dependency declared twice in the same pom -->
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate git.properties -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git\.build\.version$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.commit\.id\.(abbrev|full)$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.branch$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty><!-- project.build.outputTimestamp -->
                    </includeOnlyProperties>
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ss'Z'</dateFormat><!-- ISO 8601, as project.build.outputTimestamp needs -->
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory><!-- allow building from a source zip, without .git -->
                    <!-- Also run in the pom modules (root, BinaryInternalsApps), so project.build.outputTimestamp
                         is a valid timestamp there too, instead of the unresolved "${git.commit.time}" -->
                    <skipPoms>false</skipPoms>
                </configuration>
            </plugin>

            <!-- Add the git information to the manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- Implementation-Title/Version/Vendor in the main section, read by Package.getImplementationVersion() -->
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Release-Date>${project.build.outputTimestamp}</Release-Date>
                        </manifestEntries>

                        <manifestSections>
                            <manifestSection>
                                <name>Versions</name>
                                <manifestEntries>
                                    <Implementation-SCM-Revision>${git.commit.id.full}</Implementation-SCM-Revision>
                                    <Implementation-SCM-Branch>${git.branch}</Implementation-SCM-Branch>
                                </manifestEntries>
                            </manifestSection>
                        </manifestSections>
                    </archive>
                </configuration>
            </plugin>

            <!-- Java Compiler: all lint warnings, deprecation included; failed on by maven.compiler.failOnWarning -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-requires-automatic</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Check Style: https://maven.apache.org/plugins/maven-checkstyle-plugin/index.html -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <!-- Checkstyle version and config: see <pluginManagement> and <properties> -->
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Spotbugs -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <!-- Exclude filter and XML output: see spotbugs.* in <properties>. SpotBugs itself: the version bundled with the plugin -->
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase><!-- needs compiled classes -->
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PMD: the plugin's default rule set, the same as in the site report.
                 The build fails on priorities 1 - 3 only: the style hints of priority 4 - 5 are in the site report -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pmd</id>
                        <phase>verify</phase><!-- needs compiled classes, for type resolution -->
                        <configuration>
                            <failurePriority>3</failurePriority>
                            <printFailingErrors>true</printFailingErrors>
                        </configuration>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Make sure we did not call JDK internal APIs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jdeps-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>jdkinternals</goal> <!-- verify main classes -->
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- https://maven.apache.org/maven-ci-friendly.html -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <distributionManagement>
        <site>
            <id>site-local</id>
            <url>file:target/site-local</url>
        </site>
    </distributionManagement>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <reportSets>
                    <reportSet>
                        <reports><!-- select reports -->
                            <report>index</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <!-- Settings, UML diagrams included: see <pluginManagement>, shared with the release profile -->
                <reportSets>
                    <reportSet><!-- aggregate reportSet, to define in poms having modules -->
                        <id>aggregate</id>
                        <inherited>false</inherited><!-- don't run aggregate in child modules -->
                        <reports>
                            <report>aggregate</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <reportSets>
                    <reportSet>
                        <id>aggregate</id>
                        <inherited>false</inherited>
                        <reports>
                            <report>aggregate</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>checkstyle</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <rulesets>
                        <ruleset>${pmd.ruleset}</ruleset>
                    </rulesets>
                </configuration>
                <reportSets>
                    <reportSet><!-- by default, id = "default" -->
                        <reports><!-- select non-aggregate reports -->
                            <report>pmd</report>
                            <report>cpd</report>
                        </reports>
                    </reportSet>
                    <reportSet><!-- aggregate reportSet, to define in poms having modules -->
                        <id>aggregate</id>
                        <inherited>false</inherited> <!-- don't run aggregate in child modules -->
                        <reports>
                            <report>aggregate-pmd</report>
                            <report>aggregate-cpd</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
            </plugin>
        </plugins>
    </reporting>

    <modules>
        <module>CommonLib</module>
        <module>BinaryInternalsApps</module><!-- parent of the applications below -->
        <module>BinaryInternalsViewer</module>
        <module>BinaryInternalsWeb</module>

        <!-- Libs ready to use -->
        <module>FormatBMP</module>
        <module>FormatCLASS</module>
        <module>FormatJPEG</module>
        <module>FormatPNG</module>
        <module>FormatZIP</module>

        <!-- Libs still in development -->
        <module>FormatDEX</module>
        <module>FormatELF</module>

        <!-- Libs on hold -->
        <module>FormatPDF</module>
    </modules>

    <profiles>
        <!-- Building without .git (from a source zip): no git.commit.time, so use the build time instead -->
        <profile>
            <id>no-git</id>
            <activation>
                <file>
                    <missing>${maven.multiModuleProjectDirectory}/.git</missing>
                </file>
            </activation>
            <properties>
                <project.build.outputTimestamp>${maven.build.timestamp}</project.build.outputTimestamp>
                <!-- For the manifest, instead of the unresolved placeholders -->
                <git.commit.id.full>not-a-git-repo</git.commit.id.full>
                <git.branch>not-a-git-repo</git.branch>
            </properties>
        </profile>

        <!-- Javadoc and sources jars, only with: mvn -Prelease install -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Javadoc jar; settings, UML diagrams included: see <pluginManagement> -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Creates a jar archive of the source files of the current project.
                         jar-no-fork: the goal "jar" forks the lifecycle up to generate-sources, running enforcer, git and Checkstyle twice -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
